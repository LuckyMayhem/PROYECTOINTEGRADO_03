# ==============================================================================
# ARCHIVO DE EJEMPLO DE VARIABLES DE ENTORNO (.env.example)
# Copie este archivo como '.env' en este directorio y configure sus valores.
# ==============================================================================

# Clave secreta de Django (Genere una clave única y segura en producción)
SECRET_KEY=django-insecure-reemplazar-por-clave-secreta-en-produccion

# Modo depuración (True para desarrollo local, False para producción)
DEBUG=False

# Hosts permitidos separados por comas (ej: localhost,127.0.0.1,tu-ip-ec2,.amazonaws.com)
ALLOWED_HOSTS=localhost,127.0.0.1,testserver,tu-ip-ec2,.amazonaws.com

# Configuración de Base de Datos MySQL (Ajuste usuario y contraseña según su equipo)
DB_ENGINE=django.db.backends.mysql
DB_NAME=proyecto
DB_USER=root
DB_PASSWORD=su_password_aqui
DB_HOST=127.0.0.1
DB_PORT=3306
