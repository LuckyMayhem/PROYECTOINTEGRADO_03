[Unit]
Description=Gunicorn daemon para Safari POS (Django)
After=network.target

[Service]
User=ubuntu
Group=www-data
WorkingDirectory=/home/ubuntu/ProyectoIntegrado/proyecto_safari
ExecStart=/home/ubuntu/ProyectoIntegrado/venv/bin/gunicorn \
    --access-logfile /var/log/gunicorn/access.log \
    --error-logfile /var/log/gunicorn/error.log \
    --workers 3 \
    --bind unix:/home/ubuntu/ProyectoIntegrado/proyecto_safari/gunicorn.sock \
    proyecto_safari.wsgi:application

Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
